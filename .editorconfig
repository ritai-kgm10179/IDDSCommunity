# EditorConfig file for Cyberarms solution
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# 原始碼、專案檔、資源檔、解決方案檔與 PowerShell 腳本：採用 UTF-8 with BOM (utf-8-bom)
# 以維護 MSBuild / Roslyn (csc) / Visual Studio / Windows PowerShell 相容性與 CJK 字元正確解析
[*.{cs,csproj,resx,sln,slnx,ps1}]
charset = utf-8-bom

# JSON, Markdown, YAML, Git 設定檔：採用標準 UTF-8 without BOM (utf-8)
[*.{json,md,yml,yaml,git*,.editorconfig}]
charset = utf-8
