<Project>
  <PropertyGroup>
    <IDDSCommunityAgentPluginProjects>;IDDSCommunity.Agents.ActiveDirectory;IDDSCommunity.Agents.FileMaker;IDDSCommunity.Agents.FileZilla;IDDSCommunity.Agents.FtpServer;IDDSCommunity.Agents.Honeypot;IDDSCommunity.Agents.IisAuthentication;IDDSCommunity.Agents.MailServer;IDDSCommunity.Agents.MySql;IDDSCommunity.Agents.OpenSsh;IDDSCommunity.Agents.PostgreSql;IDDSCommunity.Agents.Radius;IDDSCommunity.Agents.RemoteDesktopGateway;IDDSCommunity.Agents.SqlServer;IDDSCommunity.Agents.TechnitiumDns;IDDSCommunity.Agents.TerminalServer;IDDSCommunity.Agents.WebSecurity;IDDSCommunity.Agents.WindowsDns;IDDSCommunity.Agents.WindowsNetworkLogon;IDDSCommunity.Agents.WinRm;</IDDSCommunityAgentPluginProjects>
  </PropertyGroup>
  <Target Name="EnsurePluginsFolder" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)Plugins" Condition="!Exists('$(OutputPath)Plugins')" />
  </Target>
  <Target Name="RemoveLegacyAgentPlugins" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' == 'IDDSCommunity.IntrusionDetection.Admin' Or '$(MSBuildProjectName)' == 'IDDSCommunity.IntrusionDetection.Service'">
    <ItemGroup>
      <LegacyAgentPlugin Include="$(OutputPath)Plugins\**\IDDSCommunity.Agents.Smtp.dll" />
      <LegacyAgentPlugin Include="$(OutputPath)Plugins\**\IDDSCommunity.Agents.Authentication.Common.dll" />
    </ItemGroup>
    <Delete Files="@(LegacyAgentPlugin)" />
  </Target>
  <Target Name="DeployIDDSCommunityAgentPlugin" AfterTargets="Build" Condition="$([System.String]::Copy('$(IDDSCommunityAgentPluginProjects)').Contains(';$(MSBuildProjectName);'))">
    <ItemGroup>
      <IDDSCommunityPluginDeploymentDirectory Include="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Admin\bin\$(Configuration)\$(TargetFramework)\Plugins" />
      <IDDSCommunityPluginDeploymentDirectory Include="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Service\bin\$(Configuration)\$(TargetFramework)\Plugins" />
    </ItemGroup>
    <MakeDir Directories="@(IDDSCommunityPluginDeploymentDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Admin\bin\$(Configuration)\$(TargetFramework)\Plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Service\bin\$(Configuration)\$(TargetFramework)\Plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)zh-TW\$(AssemblyName).resources.dll" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Admin\bin\$(Configuration)\$(TargetFramework)\Plugins\zh-TW" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)zh-TW\$(AssemblyName).resources.dll')" />
    <Copy SourceFiles="$(TargetDir)zh-TW\$(AssemblyName).resources.dll" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Service\bin\$(Configuration)\$(TargetFramework)\Plugins\zh-TW" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)zh-TW\$(AssemblyName).resources.dll')" />
    <Copy SourceFiles="$(TargetDir)IDDSCommunity.Authentication.Common.dll" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Admin\bin\$(Configuration)\$(TargetFramework)\Plugins" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)IDDSCommunity.Authentication.Common.dll')" />
    <Copy SourceFiles="$(TargetDir)IDDSCommunity.Authentication.Common.dll" DestinationFolder="$(MSBuildThisFileDirectory)src\IDDSCommunity.IntrusionDetection.Service\bin\$(Configuration)\$(TargetFramework)\Plugins" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)IDDSCommunity.Authentication.Common.dll')" />
  </Target>
  <Target Name="DeployIDDSCommunityAgentPluginsToHostOutput" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'IDDSCommunity.IntrusionDetection.Admin' Or '$(MSBuildProjectName)' == 'IDDSCommunity.IntrusionDetection.Service'">
    <ItemGroup>
      <IDDSCommunityHostAgentPlugin Include="$(MSBuildThisFileDirectory)agents\IDDSCommunity.Agents.*\bin\$(Configuration)\$(TargetFramework)\IDDSCommunity.Agents.*.dll" />
      <IDDSCommunityHostAgentDependency Include="$(MSBuildThisFileDirectory)agents\IDDSCommunity.Agents.Authentication.Common\bin\$(Configuration)\$(TargetFramework)\IDDSCommunity.Authentication.Common.dll" Condition="Exists('$(MSBuildThisFileDirectory)agents\IDDSCommunity.Agents.Authentication.Common\bin\$(Configuration)\$(TargetFramework)\IDDSCommunity.Authentication.Common.dll')" />
      <IDDSCommunityHostAgentResource Include="$(MSBuildThisFileDirectory)agents\IDDSCommunity.Agents.*\bin\$(Configuration)\$(TargetFramework)\zh-TW\IDDSCommunity.Agents.*.resources.dll" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Plugins;$(TargetDir)Plugins\zh-TW" />
    <Copy SourceFiles="@(IDDSCommunityHostAgentPlugin)" DestinationFolder="$(TargetDir)Plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IDDSCommunityHostAgentDependency)" DestinationFolder="$(TargetDir)Plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IDDSCommunityHostAgentResource)" DestinationFolder="$(TargetDir)Plugins\zh-TW" SkipUnchangedFiles="true" />
  </Target>
</Project>
